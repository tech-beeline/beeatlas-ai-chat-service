# PostgreSQL
CHAT_DB_HOST=localhost
CHAT_DB_PORT=5432
CHAT_DB_USER=myuser
CHAT_DB_PASSWORD=mysecretpassword
CHAT_DB_NAME=mydatabase

# Схема и таблица сессий
CHAT_CHAT_SCHEMA=chat
CHAT_CHAT_SESSION_TABLE=chat_session

# Таблица истории n8n Postgres Chat Memory
CHAT_CHAT_MEMORY_SCHEMA=public
CHAT_CHAT_MEMORY_TABLE=n8n_chat_histories
CHAT_CHAT_MEMORY_SESSION_ID_COLUMN=session_id
CHAT_CHAT_MEMORY_MESSAGE_COLUMN=message
CHAT_CHAT_MEMORY_ID_COLUMN=id
# Колонка даты создания; при старте сервиса добавляется в таблицу memory, если её ещё нет
CHAT_CHAT_MEMORY_CREATED_AT_COLUMN=created_at

# n8n
CHAT_N8N_BASE_URL=https://n8n.example.com
CHAT_N8N_CHAT_WEBHOOK_PATH=/webhook/7313fb89-5d51-4587-ba35-6ed80e1024f5
# Альтернатива: полный URL webhook (имеет приоритет над base + path)
# CHAT_N8N_CHAT_WEBHOOK_URL=https://n8n.example.com/webhook/beeatlas-chat
CHAT_N8N_WEBHOOK_TIMEOUT_SECONDS=10
# Проверка TLS-сертификата n8n (false — для self-signed / внутреннего CA в dev)
CHAT_N8N_SSL_VERIFY=false
